# Database — Supabase PostgreSQL (get connection string from Supabase dashboard → Settings → Database)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.vrizuiyvpsjdjykymvkv:[YOUR-DB-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Admin account (seeded on first boot)
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=your-admin-password

# Cookie signing secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Environment
ENV=production

# CORS (restrict in production)
CORS_ORIGINS=https://crelytic.ai,https://engine.crelytic.ai

# Upload
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=100

# Stripe
STRIPE_SECRET_KEY=sk_live_your-key-here
STRIPE_PUBLISHABLE_KEY=pk_live_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here
STRIPE_STARTER_PRICE_ID=price_starter-id-here
STRIPE_PRO_PRICE_ID=price_pro-id-here
STRIPE_UNLIMITED_PRICE_ID=price_unlimited-id-here
